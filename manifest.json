{
  "manifest_version": 3,
  "name": "IAChatExporter",
  "version": "0.1.0",
  "description": "Exporta conversaciones de LLMs (Gemini, Claude, ChatGPT) a archivos Markdown locales de forma simple y privada.",
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "iachatexporter@drincast",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["compat/browser-polyfill.js", "background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "compat/browser-polyfill.js",
        "parsers/gemini.js",
        "content/parser.js",
        "content/exporter.js",
        "content/content.js"
      ]
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "compat/browser-polyfill.js",
        "parsers/claude.js",
        "content/parser.js",
        "content/exporter.js",
        "content/content.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "compat/browser-polyfill.js",
        "parsers/chatgpt.js",
        "content/parser.js",
        "content/exporter.js",
        "content/content.js"
      ]
    }
  ]
}
